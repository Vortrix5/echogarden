# Copy to .env. docker-compose.yml sets the in-container service URLs itself,
# so for Docker you normally only need EG_HOST_WATCH_PATH and EG_CAPTURE_API_KEY.

# ── Host folder capture ──────────────────────────────────
# Folder on your machine that is watched for new files (mounted read-only).
EG_HOST_WATCH_PATH=/absolute/path/on/host
# EG_POLL_INTERVAL=2
# Files above this size get a placeholder card without their content.
# EG_MAX_FILE_MB=20

# ── Browser capture ──────────────────────────────────────
# Required by /capture/browser/*. Leave empty to keep those endpoints off.
EG_CAPTURE_API_KEY=

# ── Storage (paths inside the container) ─────────────────
EG_DATA_DIR=/data
EG_DB_PATH=/data/sqlite/echogarden.db
# EG_MODELS_DIR=/data/models
# EG_THUMB_DIR=/data/thumbs

# ── Services ─────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
TIKA_URL=http://tika:9998

# ── Local LLM (Ollama) ───────────────────────────────────
# EG_OLLAMA_URL=http://ollama:11434
# EG_OLLAMA_MODEL=phi3:mini
# EG_OLLAMA_TIMEOUT=180

# ── Models ───────────────────────────────────────────────
# "stub" skips the model download and returns placeholder output.
EG_WHISPER_MODE=local
EG_OPENCLIP_MODE=local
# EG_WHISPER_MODEL=base
# EG_TEXT_EMBED_MODEL=all-MiniLM-L6-v2

# ── Advanced ─────────────────────────────────────────────
# Comma-separated watch folders inside the container (compose sets /host_watch).
# EG_WATCH_ROOTS=/host_watch
